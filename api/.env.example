DATABASE_URL=sqlite:///./data/dev.db
SECRET_KEY=changeme-generate-with-secrets.token_urlsafe-48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Chatbot (Phase 7) -------------------------------------------------------
# The assistant talks to an OpenAI-compatible /chat/completions endpoint. Google
# AI Studio is the default because its free tier covers a project this size; a
# key is free from https://aistudio.google.com/apikey
GOOGLE_AI_STUDIO_API_KEY=changeme

# OpenRouter is the alternative and speaks the identical schema, so it needs no
# code change -- set the key and the two lines below. Add ":free" model ids or
# credits to the key first; a key with a zero limit answers 403 on paid models.
# OPENROUTER_API_KEY=sk-or-v1-changeme
# CHAT_BASE_URL=https://openrouter.ai/api/v1
# CHAT_MODEL=google/gemini-3.7-flash

# Optional overrides; the defaults in app/config.py are the documented ones.
# Free-tier quotas are per-model and measured (PHASE_7.md): gemini-3.5-flash is
# the default and throttles at 5 requests/minute; gemini-3.7-flash is newer but
# capped at 20 requests per DAY, which one tool-using turn spends 2-4 of.
# CHAT_MODEL=gemini-3.5-flash
# CHAT_REASONING_EFFORT=low
# CHAT_RATE_LIMIT_PER_MINUTE=10
# CLINIC_NAME=Beirut Veterinary Clinic
# CLINIC_PHONE=+961 1 000 000

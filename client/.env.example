# Where the FastAPI backend is reachable from the BROWSER.
#
# Note "localhost" even when running under Docker Compose: these requests are
# made by the user's browser on the host, not from inside the client container,
# so the compose service name (http://api:8000) would not resolve.
VITE_API_URL=http://localhost:8000

# Optional. The clinic's wall clock, used for every time shown in the UI.
# Must match `clinic_timezone` in api/.env — the backend reads a vet's working
# hours in this zone.
VITE_CLINIC_TIMEZONE=Asia/Beirut
